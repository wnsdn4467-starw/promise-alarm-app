# functions/.env 로 복사한 뒤 값을 채우세요. (.env 는 git 에 올라가지 않습니다)

# 기프티콘 이미지 AI 검증용 Gemini 키 (필수)
GEMINI_API_KEY=
# 모델 / 사용자당 하루 검증 횟수 (선택)
GEMINI_MODEL=gemini-2.0-flash
GEMINI_DAILY_LIMIT=40

# 기프티쇼 파트너 API (선택 - 실시간 PIN 조회)
GIFTISHOW_API_URL=
GIFTISHOW_API_KEY=
GIFTISHOW_USER_ID=

# 자체 조회 서버 웹훅 (선택)
GIFTICON_CHECK_URL=
GIFTICON_CHECK_TOKEN=
