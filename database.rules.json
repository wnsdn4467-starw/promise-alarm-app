{
  "rules": {
    ".read": false,
    ".write": false,

    "uid_to_code": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": "auth != null && auth.uid === $uid",
        ".validate": "newData.isString()"
      }
    },

    "shared_users": {
      "$userCode": {
        ".read": "auth != null",
        ".write": "auth != null && (!data.exists() || data.child('uid').val() === auth.uid) && (!newData.exists() || newData.child('uid').val() === auth.uid)",
        ".validate": "newData.hasChildren(['name', 'code', 'uid'])"
      }
    },

    "users_by_email": {
      "$emailKey": {
        ".read": "auth != null",
        ".write": "auth != null && (!data.exists() || data.child('uid').val() === auth.uid) && (!newData.exists() || newData.child('uid').val() === auth.uid)"
      }
    },

    "user_locations": {
      "$userCode": {
        ".read": "auth != null && (data.child('uid').val() === auth.uid || root.child('user_friends').child($userCode).child(root.child('uid_to_code').child(auth.uid).val()).exists())",
        ".write": "auth != null && (!data.exists() || data.child('uid').val() === auth.uid) && (!newData.exists() || newData.child('uid').val() === auth.uid)",
        ".validate": "newData.hasChildren(['uid', 'lat', 'lng', 'updatedAt']) && newData.child('lat').isNumber() && newData.child('lng').isNumber()"
      }
    },

    "friend_requests": {
      "$toCode": {
        ".read": "auth != null && root.child('uid_to_code').child(auth.uid).val() === $toCode",
        "$fromCode": {
          ".write": "auth != null && (root.child('uid_to_code').child(auth.uid).val() === $toCode || (newData.exists() && newData.child('fromUid').val() === auth.uid) || (!newData.exists() && root.child('uid_to_code').child(auth.uid).val() === $fromCode))",
          ".validate": "newData.hasChildren(['fromCode', 'fromUid', 'fromName'])"
        }
      }
    },

    "user_friends": {
      "$ownerCode": {
        ".read": "auth != null && root.child('uid_to_code').child(auth.uid).val() === $ownerCode",
        ".write": "auth != null && root.child('uid_to_code').child(auth.uid).val() === $ownerCode",
        "$friendCode": {
          ".write": "auth != null && ((newData.exists() && newData.child('uid').val() === auth.uid) || (!newData.exists() && root.child('uid_to_code').child(auth.uid).val() === $friendCode))"
        }
      }
    },

    "promises": {
      "$promiseId": {
        ".read": "auth != null && data.child('members').child(auth.uid).exists()",

        ".write": "auth != null && ((!data.exists() && newData.child('hostUid').val() === auth.uid && newData.child('members').child(auth.uid).exists()) || (data.exists() && data.child('hostUid').val() === auth.uid))",

        ".validate": "newData.hasChildren(['id', 'title', 'hostUid', 'members'])",

        "members": {
          "$memberUid": {
            ".validate": "newData.isBoolean() && newData.val() === true"
          }
        },

        "attendees": {
          "$memberUid": {
            ".write": "auth != null && $memberUid === auth.uid && root.child('promises').child($promiseId).child('members').child(auth.uid).exists()",
            ".validate": "!newData.exists() || (newData.hasChildren(['uid', 'name']) && newData.child('uid').val() === $memberUid && newData.child('name').isString())"
          }
        },

        "gifticons": {
          "$memberUid": {
            ".write": "auth != null && $memberUid === auth.uid && root.child('promises').child($promiseId).child('members').child(auth.uid).exists()",
            ".validate": "!newData.exists() || (newData.hasChildren(['uid', 'name', 'imageMasked']) && newData.child('uid').val() === $memberUid && newData.child('name').isString() && newData.child('imageMasked').isString() && newData.child('imageMasked').val().length < 4000000)"
          }
        }
      }
    },

    "gifticon_private": {
      ".read": false,
      ".write": false
    },

    "ai_usage": {
      ".read": false,
      ".write": false
    },

    "user_promises": {      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        "$promiseId": {
          ".write": "auth != null && (auth.uid === $uid || root.child('promises').child($promiseId).child('hostUid').val() === auth.uid)",
          ".validate": "newData.isBoolean() && newData.val() === true"
        }
      }
    }
  }
}
